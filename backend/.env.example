# ======================================
# Application & Environment
# ======================================
ENVIRONMENT=development
DEBUG=True
BACKEND_CORS_ORIGINS=http://localhost:5173,fronted-deployed-url

# ======================================
# AI (Google Gemini)
# ======================================
GOOGLE_API_KEY=your_google_api_key
GEMINI_MODEL=gemini-2.5-flash

# ======================================
# Pinecone Vector Store
# ======================================
PINECONE_API_KEY=your_pinecone_key
PINECONE_INDEX_NAME=veridict-knowledge-base
PINECONE_NAMESPACE=default

# ======================================
# PostgreSQL Database (Supabase Pooler format)
# ======================================
DATABASE_URL=postgresql+psycopg://postgres.<PROJECT_REF>:YOUR_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# ======================================
# Supabase
# ======================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key