# ==========================================
# Veridict Backend Environment Configuration
# ==========================================

SECRET_KEY=your_secret_key_here
DATABASE_URL=sqlite:///./veridict.db

# API Credentials
GOOGLE_API_KEY=your_google_gemini_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here

# ==========================================
# Single & Batch Judge LLM Settings
# ==========================================
JUDGE_PRIMARY_MODEL=gemini-2.5-flash
JUDGE_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
JUDGE_MAX_RETRIES=2
JUDGE_RETRY_BASE_DELAY=1.0
JUDGE_REQUEST_TIMEOUT=60
JUDGE_TEMPERATURE=0.0

# ==========================================
# Batch Processing Settings
# ==========================================
MAX_BATCH_ROWS=30
BATCH_SIZE=3
MAX_BATCH_RETRIES=2